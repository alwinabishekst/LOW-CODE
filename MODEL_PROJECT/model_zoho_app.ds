 application "sleep_analytics_zoho_app"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Calcutta"
 	time format = "24-hr"

 	forms
	{
		form forms
		{
			success message = "Forms Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			name
			(
				type = picklist
				values = {"Sleep_Disturbance","Sleep_Record","Sleep_Stage_Transition","Age_Group","Sleep_Disorder_Case"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			display_name
			(
				type = picklist
				values = {"Sleep Stage Transition","Sleep Disorder Case","Age Group","Sleep Record","Sleep Disturbance"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			purpose
			(
				type = picklist
				values = {"Each reported disturbance event (feeds Fig 2)","Reported sleep disorder cases (feeds Fig 5 and Fig 6)","Master list of age bands used across all analytics","Markov transition probabilities between sleep stages (feeds Fig 4)","Core dataset: one row per participant sleep observation (cleaned data entry / import)"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			fields_name
			(
    			type = text
				displayname = "fields.name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			fields_type
			(
				type = picklist
				displayname = "fields.type"
				values = {"Number","Decimal","Auto Number","Checkbox","Dropdown","Lookup","Single Line","Date"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			fields_required
			(
    			type = checkbox
				displayname = "fields.required"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			fields_unique
			(
    			type = checkbox
				displayname = "fields.unique"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			seed_data_Group_Name
			(
    			type = text
				displayname = "seed_data.Group_Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			seed_data_Min_Age
			(
				type = number
				displayname = "seed_data.Min_Age"
	 			row = 1
	 			column = 1   
				width = medium
			)
			seed_data_Max_Age
			(
				type = number
				displayname = "seed_data.Max_Age"
	 			row = 1
	 			column = 1   
				width = medium
			)
			seed_data_Sort_Order
			(
				type = number
				displayname = "seed_data.Sort_Order"
	 			row = 1
	 			column = 1   
				width = medium
			)
			fields_prefix
			(
    			type = text
				displayname = "fields.prefix"
	 			row = 1
	 			column = 1   
				width = medium
			)
			fields_validation
			(
				type = picklist
				displayname = "fields.validation"
				values = {"13 to 100","0 to 100","0.0 to 1.0","0 to 24","0 to 1"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			fields_lookup_form
			(
				type = radiobuttons
				displayname = "fields.lookup_form"
				values = {"Sleep_Record","Age_Group"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			fields_lookup_field
			(
				type = radiobuttons
				displayname = "fields.lookup_field"
				values = {"Record_ID","Group_Name"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			fields_set_by
			(
    			type = text
				displayname = "fields.set_by"
				initial value = "workflow"
	 			row = 1
	 			column = 1   
				width = medium
			)
			fields_formula
			(
    			type = text
				displayname = "fields.formula"
				initial value = "Record_Date.getMonth()"
	 			row = 1
	 			column = 1   
				width = medium
			)
			fields_choices
			(
    			type = text
				displayname = "fields.choices"
	 			row = 1
	 			column = 1   
				width = medium
			)
			fields_note
			(
    			type = text
				displayname = "fields.note"
				initial value = "Minutes to fall asleep or 1-10 score"
	 			row = 1
	 			column = 1   
				width = medium
			)
			seed_data_From_Stage
			(
				type = picklist
				displayname = "seed_data.From_Stage"
				values = {"Light","REM","Deep","Awake"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			seed_data_To_Stage
			(
				type = picklist
				displayname = "seed_data.To_Stage"
				values = {"Light","REM","Deep","Awake"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			seed_data_Probability
			(
				type = decimal
				displayname = "seed_data.Probability"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form navigation_menu
		{
			displayname = "navigation.menu"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			label
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			target
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form roles_and_permissions
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			role
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			access
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list forms_Report
		{
			displayName = "All Forms"
			show all rows from forms    
			(
				name
				display_name
				purpose
				fields_name as "fields.name"
				fields_type as "fields.type"
				fields_required as "fields.required"
				fields_unique as "fields.unique"
				seed_data_Group_Name as "seed_data.Group_Name"
				seed_data_Min_Age as "seed_data.Min_Age"
				seed_data_Max_Age as "seed_data.Max_Age"
				seed_data_Sort_Order as "seed_data.Sort_Order"
				fields_prefix as "fields.prefix"
				fields_validation as "fields.validation"
				fields_lookup_form as "fields.lookup_form"
				fields_lookup_field as "fields.lookup_field"
				fields_set_by as "fields.set_by"
				fields_formula as "fields.formula"
				fields_choices as "fields.choices"
				fields_note as "fields.note"
				seed_data_From_Stage as "seed_data.From_Stage"
				seed_data_To_Stage as "seed_data.To_Stage"
				seed_data_Probability as "seed_data.Probability"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (name == "Age_Group")
				fields = [name]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (name == "Sleep_Disorder_Case")
				fields = [name]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (name == "Sleep_Disturbance")
				fields = [name]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting4"
				{
				condition = (name == "Sleep_Record")
				fields = [name]
				format = "color:#ffffff;background-color:#3598db;"
				}
				"New Formatting5"
				{
				condition = (name == "Sleep_Stage_Transition")
				fields = [name]
				format = "color:#ffffff;background-color:#bd588b;"
				}
			)
		}
		kanban forms_by_fields_type
		{
			displayName = "Forms Board"
			show all rows from forms    
			(
				name
				display_name
				purpose
				fields_name as "fields.name"
				fields_type as "fields.type"
				fields_required as "fields.required"
				fields_unique as "fields.unique"
				seed_data_Group_Name as "seed_data.Group_Name"
				seed_data_Min_Age as "seed_data.Min_Age"
				seed_data_Max_Age as "seed_data.Max_Age"
				seed_data_Sort_Order as "seed_data.Sort_Order"
				fields_prefix as "fields.prefix"
				fields_validation as "fields.validation"
				fields_lookup_form as "fields.lookup_form"
				fields_lookup_field as "fields.lookup_field"
				fields_set_by as "fields.set_by"
				fields_formula as "fields.formula"
				fields_choices as "fields.choices"
				fields_note as "fields.note"
				seed_data_From_Stage as "seed_data.From_Stage"
				seed_data_To_Stage as "seed_data.To_Stage"
				seed_data_Probability as "seed_data.Probability"
			)
			options
			(
	 			display field = fields_type
	 		)
		}
		list navigation_menu_Report
		{
			displayName = "navigation.menu Report"
			show all rows from navigation_menu    
			(
				label
				target
			)
		}
		list roles_and_permissions_Report
		{
			displayName = "roles_and_permissions Report"
			show all rows from roles_and_permissions    
			(
				role
				access
			)
		}
	}
	pages
	{
		page DashBoard
		{
			displayname = "Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='25%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#F97164'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '20px'\n\tpaddingLeft = '20px'\n\tpaddingRight = '0px'\n\tpaddingBottom = '20px'\n\tbgColor = 'rgba(0, 0, 0, 0)'\n\n\t\twidth = '64%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginTop = '8px'\n\tcolor = '#FFFFFF'\n\tsize = '24px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'rgba(0, 0, 0, 0)'\n\n\n\tdisplayType = 'actual'\n\tdecimalPlaces = '2'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t  value = 'thisapp.forms.seed_data_Probability.avg'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '8px' \n\tmarginTop = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '14px'\n\ttype = 'Text'\n\n\tbgColor = 'rgba(0, 0, 0, 0)'\n\n\n\n\n\n\n\t  value = 'Average of seed_data.Probability'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc><pc \n\t\tpadding = '20px'\n\tbgColor = 'rgba(0, 0, 0, 0)'\n\n\t\twidth = '36%'\n\t\thAlign = 'right'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '10px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\n\tcolor = '#FFFFFF'\n\tbgColor = '#C75A50'\n\twidth = '40px'\n\theight = '40px'\n\ttype = 'icon'\n\tvalue = 'media-1-volume-up'\n\tsize = '22px'\n\tcornerRadius = '10px'\n\ticonType = 'outline'\n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='24%'\n   \t>\n\t<pane